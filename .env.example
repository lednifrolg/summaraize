# Discord bot token: Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Anthropic API key (console.anthropic.com -> API Keys). It pays for the summaries of every
# server the bot is in.
ANTHROPIC_API_KEY=
# IANA timezone for day boundaries and times in the transcript
TIMEZONE=Europe/Bratislava
# Language of the summaries and the bot's replies (sk or en)
SUMMARY_LANGUAGE=sk
