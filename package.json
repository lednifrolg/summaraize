{
  "name": "summaraize",
  "version": "0.0.0",
  "private": true,
  "description": "Discord bot that summarizes a channel's recent history with Claude",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.ts",
    "summarize": "node --env-file-if-exists=.env scripts/summarize-channel.ts",
    "test": "node --test",
    "typecheck": "tsc",
    "lint": "biome check",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
